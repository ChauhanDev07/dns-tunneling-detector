# Copy this to .env and edit as needed

# Network interface to capture (leave blank for default)
# Windows examples: INTERFACE=Ethernet  or  INTERFACE=Wi-Fi
# Linux examples:   INTERFACE=eth0       or  INTERFACE=ens33
INTERFACE=

# Alert threshold (score 0-100)
SCORE_ALERT_THRESHOLD=70

# Dashboard settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change-me-in-production

# Database path
DB_PATH=storage/dns_events.db
